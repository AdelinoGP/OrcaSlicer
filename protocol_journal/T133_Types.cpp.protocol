#include "../include/Types.hpp"
#include <algorithm>

namespace libvgcode {

///=============================================================================
/// BOUNDARY 2: EMoveType to EOptionType Mapping - lines 11-27
///=============================================================================
/// Function: move_type_to_option()
/// Purpose: Maps move types to display option categories
/// Used in: G-code visualization layer to filter display elements
/// 
/// Mapping Table:
///   Travel       -> Travels
///   Wipe         -> Wipes  
///   Retract      -> Retractions
///   Unretract    -> Unretractions
///   Seam         -> Seams
///   ToolChange   -> ToolChanges
///   ColorChange  -> ColorChanges
///   PausePrint   -> PausePrints
///   CustomGCode  -> CustomGCodes
///   [default]    -> COUNT (invalid/unknown)
EOptionType move_type_to_option(EMoveType type)

///=============================================================================
/// BOUNDARY 3: Linear Interpolation Helper (uint8_t) - lines 29-33
///=============================================================================
/// Function: lerp() - private static
/// Purpose: Blends between two 8-bit values
/// Formula: result = (1-t)*f1 + t*f2, clamped to uint8_t
/// Note: Precursor to std::lerp (C++20)
static uint8_t lerp(uint8_t f1, uint8_t f2, float t)

///=============================================================================
/// BOUNDARY 4: Color Linear Interpolation - lines 35-40
///=============================================================================
/// Function: lerp() - public
/// Purpose: Blends between two Colors
/// Implementation:
///   - Clamps parameter t to [0.0, 1.0]
///   - Performs component-wise interpolation
///   - Returns new Color with interpolated RGB values
/// Used in: G-code path color transitions
Color lerp(const Color& c1, const Color& c2, float t)

///=============================================================================
/// BOUNDARY 5: Footer - line 42
///=============================================================================
} // namespace libvgcode

