#include "Utils.hpp"

#include <assert.h>
#include <cmath>

namespace libvgcode {

///=============================================================================
/// BOUNDARY 2: Vertex Construction - lines 12-20
///=============================================================================
/// Function: add_vertex()
/// Purpose: Appends a vertex to the vertex buffer
/// Vertex Format: [pos_x, pos_y, pos_z, norm_x, norm_y, norm_z]
/// Layout: 6 floats per vertex, tightly packed
/// Usage: Builds GPU-ready vertex arrays for geometry
void add_vertex(const Vec3& position, const Vec3& normal, std::vector<float>& vertices)

///=============================================================================
/// BOUNDARY 3: Triangle Index Construction - lines 22-27
///=============================================================================
/// Function: add_triangle()
/// Purpose: Appends three indices to define a triangle
/// Index Format: 16-bit unsigned integers
/// Winding Order: Counter-clockwise (standard GL front-face)
/// Usage: Builds index buffers for indexed triangle rendering
void add_triangle(uint16_t v1, uint16_t v2, uint16_t v3, std::vector<uint16_t>& indices)

///=============================================================================
/// BOUNDARY 4: Vector Normalization - lines 29-35
///=============================================================================
/// Function: normalize()
/// Purpose: Returns unit vector in same direction as input
/// Implementation:
///   - Computes magnitude via sqrt(dot(v,v))
///   - Asserts non-zero length (debug build safety)
///   - Returns scaled vector (1/length * v)
/// Note: Uses custom dot() for consistency
Vec3 normalize(const Vec3& v)

///=============================================================================
/// BOUNDARY 5: Vector Dot Product - lines 37-40
///=============================================================================
/// Function: dot()
/// Purpose: Computes scalar dot product of two 3D vectors
/// Formula: v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]
/// Used by: normalize(), lighting calculations, visibility tests
float dot(const Vec3& v1, const Vec3& v2)

///=============================================================================
/// BOUNDARY 6: Vector Length - lines 42-45
///=============================================================================
/// Function: length()
/// Purpose: Computes Euclidean norm of 3D vector
/// Formula: sqrt(dot(v, v))
/// Used by: collision detection, scaling calculations
float length(const Vec3& v)

///=============================================================================
/// BOUNDARY 7: Vector Equality Operators - lines 47-53
///=============================================================================
/// Operator: == (Vec3, Vec3)
/// Purpose: Exact component-wise equality
/// Implementation: Returns true if all components equal
///
/// Operator: != (Vec3, Vec3)
/// Purpose: Component-wise inequality
/// Implementation: Returns !operator==
bool operator == (const Vec3& v1, const Vec3& v2)
bool operator != (const Vec3& v1, const Vec3& v2)

///=============================================================================
/// BOUNDARY 8: Vector Arithmetic Operators - lines 55-66
///=============================================================================
/// Operator: + (Vec3, Vec3)
/// Purpose: Vector addition (component-wise)
/// Returns: New Vec3 with sum components
///
/// Operator: - (Vec3, Vec3)
/// Purpose: Vector subtraction (component-wise)
/// Returns: New Vec3 with difference components
///
/// Operator: * (float, Vec3)
/// Purpose: Scalar-vector multiplication
/// Returns: New Vec3 with scaled components
Vec3 operator + (const Vec3& v1, const Vec3& v2)
Vec3 operator - (const Vec3& v1, const Vec3& v2)
Vec3 operator * (float f, const Vec3& v)

///=============================================================================
/// BOUNDARY 9: Footer - line 68
///=============================================================================
} // namespace libvgcode

